{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focus-story.dev/schema/focus-story/v1.json",
  "title": "Focus Story document",
  "description": "Portable content contract for a single-image, scroll-driven focus narrative.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "image", "viewport", "steps"],
  "properties": {
    "schemaVersion": {
      "const": "1.0",
      "description": "The version of this content contract."
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "intrinsicWidth", "intrinsicHeight", "alt"],
      "properties": {
        "src": {
          "type": "string",
          "minLength": 1,
          "description": "Fallback URL or path of the source image."
        },
        "intrinsicWidth": {
          "type": "integer",
          "minimum": 1,
          "description": "Native pixel width of the source image."
        },
        "intrinsicHeight": {
          "type": "integer",
          "minimum": 1,
          "description": "Native pixel height of the source image."
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "Alternative text for the source photograph."
        },
        "sources": {
          "type": "array",
          "description": "Optional responsive image sources, evaluated before src.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["srcset"],
            "properties": {
              "srcset": {
                "type": "string",
                "minLength": 1
              },
              "media": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "sizes": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspectRatio", "fit"],
      "properties": {
        "aspectRatio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 4,
          "description": "Width divided by height. Use 1.777778 for a 16:9 viewport."
        },
        "fit": {
          "type": "string",
          "enum": ["cover", "contain"],
          "description": "How the unzoomed source image is fitted into the fixed view window."
        },
        "minHeightPx": {
          "type": "integer",
          "minimum": 160,
          "maximum": 2160,
          "default": 320
        },
        "maxHeightVh": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 1,
          "default": 0.78,
          "description": "Maximum viewport height expressed as a fraction of the browser viewport."
        },
        "background": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "default": "#111111",
          "description": "CSS color shown where contain mode leaves empty space."
        }
      }
    },
    "initialStepId": {
      "$ref": "#/$defs/id",
      "description": "Optional id of the step shown when the experience opens. Defaults to the first step."
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "highlight": {
          "$ref": "#/$defs/highlightStyle"
        },
        "transition": {
          "$ref": "#/$defs/transition"
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 80
    },
    "unitInterval": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "nonZeroUnitInterval": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {
          "$ref": "#/$defs/unitInterval"
        },
        "y": {
          "$ref": "#/$defs/unitInterval"
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "zoom"],
      "properties": {
        "x": {
          "$ref": "#/$defs/unitInterval",
          "description": "Desired normalized source-image x-coordinate at the centre of the view window."
        },
        "y": {
          "$ref": "#/$defs/unitInterval",
          "description": "Desired normalized source-image y-coordinate at the centre of the view window."
        },
        "zoom": {
          "type": "number",
          "minimum": 1,
          "maximum": 8,
          "description": "Scale multiplier over the fitted base image scale."
        }
      }
    },
    "region": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {
              "const": "none"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "x", "y", "diameter"],
          "properties": {
            "type": {
              "const": "circle"
            },
            "x": {
              "$ref": "#/$defs/unitInterval",
              "description": "Normalized centre x-coordinate in the original source image."
            },
            "y": {
              "$ref": "#/$defs/unitInterval",
              "description": "Normalized centre y-coordinate in the original source image."
            },
            "diameter": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1,
              "description": "Diameter as a fraction of the source image's shorter intrinsic edge."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "x", "y", "width", "height"],
          "properties": {
            "type": {
              "const": "rect"
            },
            "x": {
              "$ref": "#/$defs/unitInterval",
              "description": "Normalized centre x-coordinate in the original source image."
            },
            "y": {
              "$ref": "#/$defs/unitInterval",
              "description": "Normalized centre y-coordinate in the original source image."
            },
            "width": {
              "$ref": "#/$defs/nonZeroUnitInterval",
              "description": "Rectangle width as a fraction of source image width."
            },
            "height": {
              "$ref": "#/$defs/nonZeroUnitInterval",
              "description": "Rectangle height as a fraction of source image height."
            }
          }
        }
      ]
    },
    "highlightStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "edge": {
          "type": "string",
          "enum": ["hard", "soft"],
          "default": "soft"
        },
        "feather": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.35,
          "description": "Soft-edge falloff. It is ignored for hard edges."
        },
        "fillOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.08
        },
        "dimOutside": {
          "type": "boolean",
          "default": true
        },
        "dimOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.9,
          "default": 0.42
        },
        "stroke": {
          "type": "string",
          "enum": ["none", "solid"],
          "default": "none"
        },
        "strokeWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.05,
          "default": 0.003,
          "description": "Stroke width as a fraction of the source image's shorter intrinsic edge."
        },
        "color": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "default": "#ffffff"
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000,
          "default": 650
        },
        "ease": {
          "type": "string",
          "enum": ["standard", "gentle", "linear"],
          "default": "standard",
          "description": "Named easing preset. The host may map these to CSS or an optional GSAP adapter."
        }
      }
    },
    "caption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body"],
      "properties": {
        "eyebrow": {
          "type": "string",
          "maxLength": 120
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "description": "Caption chunk in CommonMark-compatible Markdown."
        },
        "sourceLabel": {
          "type": "string",
          "maxLength": 500
        },
        "sourceHref": {
          "type": "string",
          "maxLength": 2048
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "caption", "region"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "caption": {
          "$ref": "#/$defs/caption"
        },
        "region": {
          "$ref": "#/$defs/region"
        },
        "camera": {
          "$ref": "#/$defs/camera",
          "description": "If omitted, the runtime derives a camera from the region and viewport."
        },
        "highlight": {
          "$ref": "#/$defs/highlightStyle",
          "description": "Partial overrides merge with defaults.highlight."
        },
        "transition": {
          "$ref": "#/$defs/transition",
          "description": "Partial overrides merge with defaults.transition."
        }
      }
    }
  }
}
